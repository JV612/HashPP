%option noyywrap
%{
#include <iostream>
#include <iomanip>
#include <string>
#include <algorithm>
#include <map>
#include <fstream> 

using namespace std;

map<string, string> symbolTable;

void add_to_symbol_table(const string& token, const string& lexeme) {
    if (symbolTable.find(lexeme) == symbolTable.end()) {
        symbolTable[lexeme] = token;
    }
}
%}

DIGIT       [0-9]
ID          [a-zA-Z_][a-zA-Z0-9_]*
WS          [ \t]+
NEWLINE     (\r\n|\r|\n)
ESCAPE      \\[abfnrtv\\'\\"]

%%
"main"      { add_to_symbol_table("MAIN", yytext); }
"int"       { add_to_symbol_table("INT", yytext); }
"char"      { add_to_symbol_table("CHAR", yytext); }
"long"      { add_to_symbol_table("LONG", yytext); }
"float"     { add_to_symbol_table("FLOAT", yytext); }
"double"    { add_to_symbol_table("DOUBLE", yytext); }
"bool"      { add_to_symbol_table("BOOL", yytext); }
"if"        { add_to_symbol_table("IF", yytext); }
"else"      { add_to_symbol_table("ELSE", yytext); }
"for"       { add_to_symbol_table("FOR", yytext); }
"while"     { add_to_symbol_table("WHILE", yytext); }
"do"        { add_to_symbol_table("DO", yytext); }
"until"     { add_to_symbol_table("UNTIL", yytext); }
"break"     { add_to_symbol_table("BREAK", yytext); }
"continue"  { add_to_symbol_table("CONTINUE", yytext); }
"goto"      { add_to_symbol_table("GOTO", yytext); }
"switch"    { add_to_symbol_table("SWITCH", yytext); }
"case"      { add_to_symbol_table("CASE", yytext); }
"default"   { add_to_symbol_table("DEFAULT", yytext); }
"return"    { add_to_symbol_table("RETURN", yytext); }
"void"      { add_to_symbol_table("VOID", yytext); }
"typedef"   { add_to_symbol_table("TYPEDEF", yytext); }
"enum"      { add_to_symbol_table("ENUM", yytext); }
"union"     { add_to_symbol_table("UNION", yytext); }
"struct"    { add_to_symbol_table("STRUCT", yytext); }
"static"    { add_to_symbol_table("STATIC", yytext); }
"true"      { add_to_symbol_table("TRUE", yytext); }
"false"     { add_to_symbol_table("FALSE", yytext); }
"nullptr"   { add_to_symbol_table("NULLPTR", yytext); }
"sizeof"    { add_to_symbol_table("SIZEOF", yytext); }

"//".*      { add_to_symbol_table("COMMENT", yytext); }

"+="        { add_to_symbol_table("ADD_ASSIGN", yytext); }
"-="        { add_to_symbol_table("SUB_ASSIGN", yytext); }
"*="        { add_to_symbol_table("MUL_ASSIGN", yytext); }
"/="        { add_to_symbol_table("DIV_ASSIGN", yytext); }
"%="        { add_to_symbol_table("MOD_ASSIGN", yytext); }
"^="        { add_to_symbol_table("XOR_ASSIGN", yytext); }
"&="        { add_to_symbol_table("AND_ASSIGN", yytext); }
"|="        { add_to_symbol_table("OR_ASSIGN", yytext); }
"<<="       { add_to_symbol_table("LSHIFT_ASSIGN", yytext); }
">>="       { add_to_symbol_table("RSHIFT_ASSIGN", yytext); }
"=="        { add_to_symbol_table("EQUAL", yytext); }
"!="        { add_to_symbol_table("NOT_EQUAL", yytext); }
"&&"        { add_to_symbol_table("LOG_AND", yytext); }
"||"        { add_to_symbol_table("LOG_OR", yytext); }
"->"        { add_to_symbol_table("PTR_OP", yytext); }
"="         { add_to_symbol_table("ASSIGN", yytext); }
"<="        { add_to_symbol_table("LESS_EQUAL", yytext); }
">="        { add_to_symbol_table("GREATER_EQUAL", yytext); }
">>"        { add_to_symbol_table("RSHIFT_OP", yytext); }
"<<"        { add_to_symbol_table("LSHIFT_OP", yytext); }
"<"         { add_to_symbol_table("LESS", yytext); }
">"         { add_to_symbol_table("GREATER", yytext); }
"!"         { add_to_symbol_table("LOG_NOT", yytext); }
"++"        { add_to_symbol_table("INCREMENT", yytext); }
"--"        { add_to_symbol_table("DECREMENT", yytext); }
"+"         { add_to_symbol_table("ADD", yytext); }
"-"         { add_to_symbol_table("SUBTRACT", yytext); }
"*"         { add_to_symbol_table("STAR", yytext); }
"/"         { add_to_symbol_table("DIVIDE", yytext); }
"%"         { add_to_symbol_table("MODULO", yytext); }
"^"         { add_to_symbol_table("XOR", yytext); }
"&"         { add_to_symbol_table("AND", yytext); }
"|"         { add_to_symbol_table("OR", yytext); }
"~"         { add_to_symbol_table("BITWISE_NOT", yytext); }
"?"         { add_to_symbol_table("QUESTION", yytext); }
":"         { add_to_symbol_table("COLON", yytext); }

"("         { add_to_symbol_table("LPARAN", yytext); }
")"         { add_to_symbol_table("RPARAN", yytext); }
"{"         { add_to_symbol_table("LCBRACKET", yytext); }
"}"         { add_to_symbol_table("RCBRACKET", yytext); }
"["         { add_to_symbol_table("LSQBRACKET", yytext); }
"]"         { add_to_symbol_table("RSQBRACKET", yytext); }
";"         { add_to_symbol_table("SEMI_COLON", yytext); }
","         { add_to_symbol_table("COMMA", yytext); }

(({DIGIT}+"."{DIGIT}*)|("."{DIGIT}+))[fF] {
    add_to_symbol_table("FLOAT_LITERAL", yytext);
}

{DIGIT}+[fF] {
    add_to_symbol_table("FLOAT_LITERAL", yytext);
}

(({DIGIT}+"."{DIGIT}*)|("."{DIGIT}+)) {
    add_to_symbol_table("DOUBLE_LITERAL", yytext);
}

"." {
    add_to_symbol_table("DOT", yytext); 
}

{DIGIT}+ {
    add_to_symbol_table("INT_LITERAL", yytext);
}

\'([^\\'\n]|{ESCAPE})\' {
    add_to_symbol_table("CHAR_LITERAL", yytext);
}

\"([^\\\"\n]|{ESCAPE})*\" {
    add_to_symbol_table("STRING_LITERAL", yytext);
}

{ID} {
    add_to_symbol_table("IDENTIFIER", yytext);
}

{WS}        { /* Skip whitespace */ }
{NEWLINE}   { /* Ignore newlines */ }

.           { add_to_symbol_table("UNKNOWN", yytext); }

%%

int main(int argc, char* argv[]) {
    if (argc != 2) {
        cerr << "Usage: " << argv[0] << " <input_file>\n";
        return 1;
    }

    FILE* file = fopen(argv[1], "r");
    if (!file) {
        cerr << "Error: Cannot open file " << argv[1] << "\n";
        return 1;
    }

    yyin = file;  // Set flex input to read from the file
    yylex();      // Start lexical analysis
    fclose(file); // Close the file

    // Create result directory if it doesn't exist
    system("mkdir -p results");

    // Extract input filename without path
    string inputPath = argv[1];
    size_t lastSlash = inputPath.find_last_of("/\\");
    string inputFileName = (lastSlash == string::npos) ? inputPath : inputPath.substr(lastSlash + 1);

    // Remove .c or .cpp extension from inputFileName if present
    string baseFileName = inputFileName;

    // Find last dot
    size_t dotPos = baseFileName.rfind('.');
    if (dotPos != string::npos) {
        string ext = baseFileName.substr(dotPos); // get extension
        if (ext == ".c" || ext == ".cpp") {
            baseFileName = baseFileName.substr(0, dotPos);
        }
    }

    // Construct output file path
    string outputFilePath = "results/table_" + baseFileName + ".txt";

    ofstream outputFile(outputFilePath);
    if (!outputFile.is_open()) {
        cerr << "Failed to create output file: " << outputFilePath << endl;
        return 1;
    }

    size_t maxLexemeLen = 0;
    for (const auto& entry : symbolTable) {
        maxLexemeLen = std::max(maxLexemeLen, entry.first.size());
    }

    size_t lexemeColumnWidth = maxLexemeLen + 4;

    outputFile << "Symbol Table:\n";
    outputFile << string(lexemeColumnWidth + 20, '-') << "\n";
    outputFile << left << setw(lexemeColumnWidth) << "Lexeme" 
            << setw(20) << "Token" << "\n";
    outputFile << string(lexemeColumnWidth + 20, '-') << "\n";

    for (const auto& entry : symbolTable) {
        outputFile << left << setw(lexemeColumnWidth) << entry.first
                << setw(20) << entry.second << "\n";
    }

    outputFile.close();
    cout << "Symbol table has been written to '" << outputFilePath << "' file." << endl;

    return 0;
}
